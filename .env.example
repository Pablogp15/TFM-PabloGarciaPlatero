# Copia este archivo como .env y reemplaza los valores de ejemplo.
# La aplicación y la generación están pensadas para ejecutarse en local.

# --- Aplicación ---------------------------------------------------------
APP_NAME=MiniPaint AI
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=http://localhost:5173

# Genera cada secreto con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# En producción, con HTTPS, debe valer true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Base de datos ------------------------------------------------------
POSTGRES_DB=minipaint
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Rol propietario del esquema: solo lo usa Alembic.
POSTGRES_MIGRATOR_USER=minipaint_migrator
POSTGRES_MIGRATOR_PASSWORD=REEMPLAZAR_POR_UNA_PASSWORD_LOCAL

# Rol de la aplicación: sin DDL, solo DML.
POSTGRES_APP_USER=minipaint_app
POSTGRES_APP_PASSWORD=REEMPLAZAR_POR_OTRA_PASSWORD_LOCAL

DATABASE_URL=postgresql+psycopg://minipaint_app:cambia-esta-password-tambien@localhost:5432/minipaint
DATABASE_MIGRATION_URL=postgresql+psycopg://minipaint_migrator:cambia-esta-password@localhost:5432/minipaint

# --- Almacenamiento de imágenes -----------------------------------------
# Backend local sobre el sistema de archivos. En Docker se monta un volumen
# persistente en /app/storage.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=storage

# Límites de subida y validación de imágenes.
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=24000000
MAX_IMAGE_DIMENSION=4096
MAX_IMAGES_PER_PROJECT=50

# --- Generación de imágenes (F4) -----------------------------------------
# ``http`` delega en el servicio GPU local; ``stub`` solo sirve para pruebas.
GENERATION_PROVIDER=http
GENERATION_SERVICE_URL=http://host.docker.internal:8188
GENERATION_SERVICE_TOKEN=REEMPLAZAR_POR_OTRO_SECRETO_ALEATORIO_DE_64_CARACTERES
GENERATION_MODEL_NAME=Qwen-Image-Edit-2511
GENERATION_JOB_TIMEOUT_SECONDS=1800
GENERATION_POLL_INTERVAL_SECONDS=1.5
GENERATION_WORKER_POLL_SECONDS=2
GENERATION_MAX_ACTIVE_PER_PROJECT=1
GENERATION_MAX_PER_PROJECT=100
GENERATION_MAX_OUTPUT_BYTES=20971520

# Rutas usadas por scripts/start-local.ps1. miniconda está al nivel de TFM,
# como carpeta hermana de minipaintAI.
# Si tu entorno tiene otro nombre, actualiza GPU_CONDA_ENV o define
# MINICONDA_PYTHON con la ruta completa a su python.exe.
MINICONDA_ROOT=..\miniconda3
GPU_CONDA_ENV=qwen2511
# MINICONDA_PYTHON=C:\ruta\completa\al\entorno\python.exe
DIFFSYNTH_MODEL_BASE_PATH=..\AI\qwenImageEdit\models
GPU_STARTUP_TIMEOUT_SECONDS=1800

# Guias RAG locales en CPU
GUIDE_MODEL=qwen3-vl:4b-instruct-q4_K_M
GUIDE_OLLAMA_URL=http://ollama:11434
GUIDE_EMBEDDING_PATH=/models/multilingual-e5-small
GUIDE_EMBEDDING_REVISION=local-v1
GUIDE_TIMEOUT_SECONDS=1800
